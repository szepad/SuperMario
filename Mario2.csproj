<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationIcon>icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Gum.raylib" Version="2026.10.1.1" />
        <PackageReference Include="Gum.Themes.Editor.Raylib" Version="2026.10.1.1" />
        <PackageReference Include="NativeFileDialogSharp" Version="0.6.0-alpha" />
        <PackageReference Include="Raylib-cs" Version="8.1.0" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="res\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="levels\**">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Automate macOS .app generation after publishing -->
    <Target Name="CreateMacAppBundle" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('osx'))">
        <PropertyGroup>
            <AppBundleDir>$(PublishDir)..\$(AssemblyName).app</AppBundleDir>
            <ContentsDir>$(AppBundleDir)\Contents</ContentsDir>
            <MacOsDir>$(ContentsDir)\MacOS</MacOsDir>
            <ResourcesDir>$(ContentsDir)\Resources</ResourcesDir>
        </PropertyGroup>

        <Message Importance="High" Text="Packaging macOS .app bundle..." />
        
        <RemoveDir Directories="$(AppBundleDir)" />

        <MakeDir Directories="$(AppBundleDir);$(ContentsDir);$(MacOsDir);$(ResourcesDir)" />

        <ItemGroup>
            <PublishFiles Include="$(PublishDir)**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(PublishFiles)" DestinationFolder="$(MacOsDir)\%(RecursiveDir)" />

        <Copy SourceFiles="Info.plist" DestinationFolder="$(ContentsDir)" />
        <Copy SourceFiles="icon.icns" DestinationFolder="$(ResourcesDir)" />

        <Exec Command="chmod +x &quot;$(MacOsDir)/$(AssemblyName)&quot;" />

        <Message Importance="High" Text="App bundle successfully created at: $(AppBundleDir)" />
    </Target>
</Project>
